# claude-setup environment template
# Copy to .env and fill in real values. .env is gitignored.

# ── GitHub MCP ──
# Generate at https://github.com/settings/tokens (classic)
# Required scopes: repo + read:org
GITHUB_PAT=

# ── Sejong production DB (Track A only) ──
# BID_DB_HOST=
# BID_DB_PORT=3306
# BID_DB_USER=
# BID_DB_PASS=
# BID_DB_NAME=BID

# ── AWS (Track A) ──
# AWS_PROFILE=default
# AWS_REGION=ap-northeast-2

# ── Anthropic (rarely needed; Claude Code uses OAuth) ──
# ANTHROPIC_API_KEY=
